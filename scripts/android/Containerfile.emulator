# Headless Android emulator for the smoke test (scripts/android/smoke.sh). Needs /dev/kvm.
FROM localhost/common-ground-android:36
ENV PATH=$PATH:/opt/android-sdk/emulator
RUN apt-get update && apt-get install -y --no-install-recommends libpulse0 libxkbfile1 \
    libgl1 libnss3 libxcomposite1 libxcursor1 libxdamage1 libxi6 libxtst6 libasound2t64 \
 && rm -rf /var/lib/apt/lists/* \
 && sdkmanager "emulator" "system-images;android-36;google_apis;x86_64" > /dev/null \
 && echo no | avdmanager create avd -n smoke -k "system-images;android-36;google_apis;x86_64" \
    -d pixel_7 > /dev/null
