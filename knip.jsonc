{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  // Entries knip's plugins cannot see: the theme script index.html loads, the Deno functions,
  // the script CI runs (.gitlab/ci/database.yml), and the Netflix extension's entries and build.
  "entry": [
    "public/mode-init.js",
    "extension/src/{content,page,popup}.ts",
    "public/app-link/forward.js",
    "supabase/functions/*/index.ts",
    "scripts/e2e/env.ts",
  ],
  "project": [
    "src/**/*.{ts,svelte}",
    "scripts/**/*.ts",
    "supabase/functions/**/*.ts",
    "tests/**/*.ts",
    "extension/**/*.ts",
  ],
  // Vendored shadcn-svelte barrels and generated database types.
  "ignore": ["src/lib/components/ui/**", "src/shared/infrastructure/database.types.ts"],
  // tw-animate-css and the @fontsource-variable fonts are imported from src/app.css, which knip does not read; jscpd is run by
  // scripts/guard/duplication.ts as a child process; @capacitor/keyboard works from
  // capacitor.config.ts alone.
  "ignoreDependencies": [
    "tw-animate-css",
    "@fontsource-variable/inter",
    "@fontsource-variable/lora",
    "jscpd",
    "@capacitor/keyboard",
  ],
  // Types and interfaces are public shapes even when only their own file uses them yet.
  "ignoreExportsUsedInFile": { "interface": true, "type": true },
}
