# Copy to cinepro/.env (gitignored). A TMDB v3 API key: https://www.themoviedb.org/settings/api
TMDB_API_KEY=replace_with_your_tmdb_api_key
# Optional, read by compose.yml: where the app reaches Core, and which origin may call it.
# scripts/cinepro/server.sh sets both for a published Core; leave them out for local use.
# CINEPRO_PUBLIC_URL=https://<host>.ts.net:8443
# CINEPRO_CORS_ORIGIN=*
