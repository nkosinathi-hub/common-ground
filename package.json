{
  "name": "common-ground",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@10.34.3",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "check": "svelte-check --tsconfig ./tsconfig.json --fail-on-warnings",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:db": "supabase test db",
    "test:e2e": "playwright test",
    "lines": "tsx scripts/guard/static-checks.ts",
    "cycles": "madge --circular --extensions ts --ts-config tsconfig.json src scripts supabase/functions",
    "setup": "tsx scripts/setup/index.ts",
    "guard": "tsx scripts/guard/index.ts",
    "guard:e2e": "tsx scripts/guard/index.ts --e2e",
    "db:types": "supabase gen types typescript --local --schema public > src/shared/infrastructure/database.types.ts",
    "secrets:tmdb": "bash scripts/load-tmdb-secrets.sh"
  },
  "dependencies": {
    "@lucide/svelte": "^1.57.0",
    "@supabase/supabase-js": "^2.117.3",
    "bits-ui": "^2.19.5",
    "clsx": "^2.1.1",
    "svelte": "^5.57.2",
    "svelte-sonner": "^1.2.1",
    "tailwind-merge": "^3.7.0",
    "tailwind-variants": "^3.3.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^10.0.1",
    "@internationalized/date": "^3.12.4",
    "@playwright/test": "^1.64.1",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/svelte": "^5.4.2",
    "@tsconfig/svelte": "^5.0.8",
    "@types/node": "^26.6.5",
    "@vitest/coverage-v8": "^5.0.4",
    "eslint": "^10.12.0",
    "eslint-plugin-svelte": "^3.23.1",
    "globals": "^17.13.0",
    "jsdom": "^30.1.3",
    "lefthook": "^2.2.2",
    "madge": "8.0.0",
    "mode-watcher": "^1.1.0",
    "prettier": "^3.9.10",
    "prettier-plugin-svelte": "^4.1.1",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "supabase": "^2.121.0",
    "svelte-check": "^4.7.6",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "tw-animate-css": "^1.4.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.4"
  }
}
