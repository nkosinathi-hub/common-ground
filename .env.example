# Public client configuration. Safe in the bundle only because RLS is tested.
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_ANON_KEY=sb_publishable_example
# GitHub Pages sub-path, e.g. /common-ground/ (default /)
PAGES_BASE_PATH=/
# Public website the Android app's email and invite links point to (app build only)
VITE_PUBLIC_APP_URL=
# Push for the Android app: on once android/app/google-services.json exists (app build only)
VITE_PUSH=
# Playback: the household Jellyfin server (https origin only), allowed by the CSP at build time
VITE_JELLYFIN_ORIGIN=
# End-to-end builds only: the local media server for playback tests (http://127.0.0.1:<port>)
VITE_PLAYBACK_FIXTURE_ORIGIN=

# Optional self-hosted CinePro Core (https origin). A loopback http Core is allowed by `pnpm dev`
# alone: put it in .env.development.local, never here or in .env.local (docs/runbooks/cinepro.md)
VITE_CINEPRO_CORE_ORIGIN=
